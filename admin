--// SERVICES //--
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--// SETTINGS //--
local Whitelist = _G.G_Whitelist or {}
local Prefix = _G.Prefix or ":"
local KickMsg = _G.DefaultKickMessage or "Kicked."

--// HELPERS //--
local function getChar(plr)
    local p = plr or LocalPlayer
    return p.Character or p.CharacterAdded:Wait()
end

local function getTarget(str)
    if not str then return nil end
    local lowStr = str:lower()
    if lowStr == "all" or lowStr == "everyone" then return "all" end
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #lowStr) == lowStr or p.DisplayName:lower():sub(1, #lowStr) == lowStr then
            return p
        end
    end
    return nil 
end

--// COMMAND REPOSITORY //--
local Commands = {}

-- [NEW] :RESET Command (Restores original Name and Tag)
Commands.reset = function(sender)
    local char = sender.Character
    if char then
        local tagUI = char:FindFirstChild("NameTagUI", true)
        if tagUI then
            local label = tagUI:FindFirstChild("Text", true)
            local iconLabel = tagUI:FindFirstChild("Icon", true)
            local iconText = iconLabel and iconLabel:FindFirstChild("TextLabel")

            -- Restore to original Roblox Name/Display
            if label then 
                label.Text = sender.DisplayName 
                if label:FindFirstChild("Shadow") then label.Shadow.Text = sender.DisplayName end
            end
            
            -- Reset Country Tag (Usually empty or default)
            if iconText then iconText.Text = "" end
            sender:SetAttribute("country", "")
        end
    end
    print("[ADMIN] Reset visuals for: " .. sender.Name)
end

Commands.check = function()
    local cb = ReplicatedStorage:FindFirstChild("CB")
    if cb then cb:FireServer(".") end
end

Commands.changename = function(sender, args, fullText)
    local firstSpace = fullText:find(" ")
    if not firstSpace then return end
    local newName = fullText:sub(firstSpace + 1)
    
    local char = sender.Character
    local tagUI = char and char:FindFirstChild("NameTagUI", true)
    local label = tagUI and tagUI:FindFirstChild("Text", true)
    if label then
        label.Text = newName
        if label:FindFirstChild("Shadow") then label.Shadow.Text = newName end
    end
end

Commands.changetag = function(sender, args)
    local country = args[1]
    if country then
        sender:SetAttribute("country", country)
        local char = sender.Character
        local tagUI = char and char:FindFirstChild("NameTagUI", true)
        local icon = tagUI and tagUI:FindFirstChild("Icon", true)
        local label = icon and icon:FindFirstChild("TextLabel")
        if label then label.Text = country end
    end
end

Commands.kill = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local rem = ReplicatedStorage:WaitForChild("Remotes", 3):FindFirstChild("PlayerHurtMe")
    if rem then rem:FireServer(100) end
end

--// CORE ENGINE //--
local lastCmd = ""
local function processMsg(sender, fullText)
    if not Whitelist[sender.Name] then return end
    if fullText:sub(1, #Prefix) ~= Prefix then return end
    
    if fullText == lastCmd then return end
    lastCmd = fullText
    task.delay(0.5, function() lastCmd = "" end)

    local split = fullText:split(" ")
    local cmdName = split[1]:sub(#Prefix + 1):lower() 
    
    table.remove(split, 1) 
    local target = getTarget(split[1])
    local isTargeted = (target == "all" or target == LocalPlayer)

    if Commands[cmdName] then
        Commands[cmdName](sender, split, fullText, isTargeted)
    end
end

--// REJOIN & CHARACTER PERSISTENCE //--
local function setupPlayer(plr)
    -- This ensures the link stays active even if they leave and come back
    plr.Chatted:Connect(function(msg)
        processMsg(plr, msg)
    end)
    
    -- Auto-Reset visuals whenever their character spawns (Prevents "Double Name" bugs)
    plr.CharacterAdded:Connect(function(char)
        task.wait(1) -- Wait for character to initialize
        if Commands.reset then Commands.reset(plr) end
    end)
end

-- Load for everyone currently in server
for _, p in pairs(Players:GetPlayers()) do
    setupPlayer(p)
end

-- Load for anyone who joins/rejoins later
Players.PlayerAdded:Connect(setupPlayer)

-- Bubble Chat Detection
task.spawn(function()
    local pGui = LocalPlayer:WaitForChild("PlayerGui")
    while true do
        local bChat = pGui:FindFirstChild("BubbleChat")
        local bList = bChat and bChat:FindFirstChild("BubbleChatList", true)
        if bList then
            bList.ChildAdded:Connect(function(child)
                task.wait(0.1)
                local tl = child:FindFirstChildWhichIsA("TextLabel", true)
                if tl then
                    for _, admin in pairs(Players:GetPlayers()) do
                        if Whitelist[admin.Name] then processMsg(admin, tl.Text) end
                    end
                end
            end)
            break
        end
        task.wait(1)
    end
end)

