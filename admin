--// SERVICES //--
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--// SETTINGS //--
local Whitelist = _G.G_Whitelist or {}
local Prefix = _G.Prefix or ":"
local KickMsg = _G.DefaultKickMessage or "Kicked."

--// HELPERS //--
local function getChar(plr)
    local p = plr or LocalPlayer
    return p.Character or p.CharacterAdded:Wait()
end

local function getTarget(str)
    if not str then return nil end
    local lowStr = str:lower()
    if lowStr == "all" or lowStr == "everyone" then return "all" end
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #lowStr) == lowStr or p.DisplayName:lower():sub(1, #lowStr) == lowStr then
            return p
        end
    end
    return nil 
end

--// COMMAND REPOSITORY //--
local Commands = {}

Commands.reset = function(sender)
    local char = sender.Character
    if not char then return end
    
    local tagUI = char:FindFirstChild("NameTagUI", true)
    if tagUI then
        local label = tagUI:FindFirstChild("Text", true)
        local iconLabel = tagUI:FindFirstChild("Icon", true)
        local iconText = iconLabel and iconLabel:FindFirstChild("TextLabel")

        -- Check attributes first; if empty, use original Name/Tag
        local savedName = sender:GetAttribute("SavedCustomName") or sender.DisplayName
        local savedTag = sender:GetAttribute("SavedCustomTag") or ""

        if label then 
            label.Text = savedName 
            if label:FindFirstChild("Shadow") then label.Shadow.Text = savedName end
        end
        
        if iconText then iconText.Text = savedTag end
    end
end

Commands.check = function(sender)
    warn("[SYSTEM] Admin check received from: " .. (sender and sender.Name or "Unknown"))
    local cb = ReplicatedStorage:FindFirstChild("CB")
    if cb then cb:FireServer(".") end
end

Commands.changename = function(sender, args, fullText)
    local firstSpace = fullText:find(" ")
    if not firstSpace then return end
    local newName = fullText:sub(firstSpace + 1)
    
    sender:SetAttribute("SavedCustomName", newName) -- Store for persistence
    Commands.reset(sender) -- Apply immediately
end

Commands.changetag = function(sender, args)
    local country = args[1]
    if country then
        sender:SetAttribute("SavedCustomTag", country) -- Store for persistence
        Commands.reset(sender) -- Apply immediately
    end
end

Commands.kick = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local reason = table.concat(args, " ", 2)
    if reason == "" then reason = KickMsg end
    if LocalPlayer.Name ~= sender.Name then LocalPlayer:Kick("\n" .. reason) end
end

Commands.say = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local msg = table.concat(args, " ", 2)
    local cb = ReplicatedStorage:FindFirstChild("CB")
    if cb and msg ~= "" then cb:FireServer(msg) end
end

Commands.kill = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local rem = ReplicatedStorage:WaitForChild("Remotes", 3):FindFirstChild("PlayerHurtMe")
    if rem then rem:FireServer(100) end
end

Commands.leave = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local rem = ReplicatedStorage:WaitForChild("Remotes", 3):FindFirstChild("RequestPlayerExitWorld")
    if rem then rem:InvokeServer() else LocalPlayer:Kick("Leaving...") end
end

Commands.freeze = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local root = getChar():FindFirstChild("HumanoidRootPart")
    if root then root.Anchored = true end
end

Commands.unfreeze = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local root = getChar():FindFirstChild("HumanoidRootPart")
    if root then root.Anchored = false end
end

--// ENGINE //--
local lastCmd = ""
local function processMsg(sender, fullText)
    if not sender or not Whitelist[sender.Name] then return end
    if fullText:sub(1, #Prefix) ~= Prefix then return end
    
    -- Anti-spam debounce
    if fullText == lastCmd then return end
    lastCmd = fullText
    task.delay(0.5, function() lastCmd = "" end)

    local split = fullText:split(" ")
    local cmdName = split[1]:sub(#Prefix + 1):lower() 
    
    table.remove(split, 1) 
    local target = getTarget(split[1])
    local isTargeted = (target == "all" or target == LocalPlayer)

    if Commands[cmdName] then
        print("[ADMIN] " .. sender.Name .. " used: " .. cmdName)
        Commands[cmdName](sender, split, fullText, isTargeted)
    end
end

--// REMOTE LISTENER (Replaces Bubble Chat) //--
local cb = ReplicatedStorage:WaitForChild("CB", 5)
if cb and cb:IsA("RemoteEvent") then
    cb.OnClientEvent:Connect(function(msg, senderData)
        -- Logic to handle if senderData is a Name String or Player Object
        local sender = typeof(senderData) == "string" and Players:FindFirstChild(senderData) or senderData
        if sender and Whitelist[sender.Name] then
            processMsg(sender, msg)
        end
    end)
end

--// PLAYER SETUP //--
local function setupPlayer(plr)
    if not (Whitelist[plr.Name] or Whitelist[tostring(plr.UserId)]) then return end
    
    if plr:GetAttribute("AdminHooked") then return end
    plr:SetAttribute("AdminHooked", true)

    plr.Chatted:Connect(function(msg)
        processMsg(plr, msg)
    end)

    plr.CharacterAdded:Connect(function(char)
        task.wait(1)
        if Commands.reset then Commands.reset(plr) end
    end)
    
    if plr.Character then task.spawn(Commands.reset, plr) end
end

for _, p in pairs(Players:GetPlayers()) do task.spawn(setupPlayer, p) end
Players.PlayerAdded:Connect(setupPlayer)

