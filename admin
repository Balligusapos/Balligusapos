--// SERVICES //--
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")

--// SETTINGS //--
_G.G_Whitelist = _G.G_Whitelist or {[LocalPlayer.Name] = true}
local Whitelist = _G.G_Whitelist
local Prefix = _G.Prefix or ":"
local KickMsg = _G.DefaultKickMessage or "Kicked."

--// THE HIJACK & CLEANUP ENGINE //--
local function applyIdentity(plr)
    local char = plr.Character
    if not char then return end

    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end

    -- FIX: Find all NameTagUIs and destroy duplicates
    local foundTags = {}
    for _, child in pairs(root:GetChildren()) do
        if child.Name == "NameTagUI" or child:IsA("BillboardGui") then
            table.insert(foundTags, child)
        end
    end

    -- Keep the first one found, destroy the rest to prevent "Double Names"
    if #foundTags > 1 then
        for i = 2, #foundTags do
            foundTags[i]:Destroy()
        end
    end

    local tagUI = foundTags[1]
    if not tagUI then return end

    local label = tagUI:FindFirstChild("Text", true)
    local iconLabel = tagUI:FindFirstChild("Icon", true)
    local iconText = iconLabel and iconLabel:FindFirstChild("TextLabel")

    -- 1. APPLY CUSTOM NAME
    local customName = plr:GetAttribute("CustomName")
    if label then
        if customName then
            label.Text = customName
            local shadow = label:FindFirstChild("Shadow")
            if shadow then shadow.Text = customName end
        elseif plr:GetAttribute("IsUnnamed") then
            label.Text = ""
            if label:FindFirstChild("Shadow") then label.Shadow.Text = "" end
        end
    end

    -- 2. APPLY CUSTOM TAG/FLAG
    local customTag = plr:GetAttribute("country")
    if iconText then
        if customTag then
            iconLabel.Visible = true
            iconText.Text = customTag
        elseif plr:GetAttribute("IsUnnamed") then
            iconLabel.Visible = false
            iconText.Text = ""
        end
    end
end

--// COMMAND REPOSITORY //--
local Commands = {}

-- Identity Commands
Commands.unname = function(sender)
    sender:SetAttribute("CustomName", nil)
    sender:SetAttribute("country", nil)
    sender:SetAttribute("IsUnnamed", true)
    applyIdentity(sender)
end

Commands.changename = function(sender, args, fullText)
    local firstSpace = fullText:find(" ")
    if not firstSpace then return end
    local newName = fullText:sub(firstSpace + 1)
    sender:SetAttribute("IsUnnamed", false)
    sender:SetAttribute("CustomName", newName)
    applyIdentity(sender)
end

Commands.changetag = function(sender, args)
    local country = args[1] or ""
    sender:SetAttribute("IsUnnamed", false)
    sender:SetAttribute("country", country)
    applyIdentity(sender)
end

Commands.reset = function(sender)
    sender:SetAttribute("CustomName", nil)
    sender:SetAttribute("country", nil)
    sender:SetAttribute("IsUnnamed", false)
    local char = sender.Character
    if char then
        local label = char:FindFirstChild("Text", true)
        if label then label.Text = sender.DisplayName end
    end
end

-- Utility Commands
Commands.check = function(sender)
    warn("[ADMIN] Ping from: " .. sender.Name)
    local cb = ReplicatedStorage:FindFirstChild("CB")
    if cb then cb:FireServer(".") end
end

Commands.freeze = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local char = LocalPlayer.Character
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.Anchored = true end
        end
    end
end

Commands.unfreeze = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local char = LocalPlayer.Character
    if char then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then part.Anchored = false end
        end
    end
end

Commands.kick = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local reason = table.concat(args, " ", 2) or KickMsg
    if LocalPlayer.Name ~= sender.Name then LocalPlayer:Kick("\n" .. reason) end
end

Commands.say = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local cb = ReplicatedStorage:FindFirstChild("CB")
    if cb then cb:FireServer(table.concat(args, " ", 2)) end
end

Commands.kill = function(sender, args, _, isTargeted)
    if not isTargeted then return end
    local rem = ReplicatedStorage:WaitForChild("Remotes", 3):FindFirstChild("PlayerHurtMe")
    if rem then rem:FireServer(100) end
end

--// ENGINE LOGIC //--
local function processMsg(sender, fullText)
    if not Whitelist[sender.Name] then return end
    if fullText:sub(1, #Prefix) ~= Prefix then return end
    
    local split = fullText:split(" ")
    local cmdName = split[1]:sub(#Prefix + 1):lower()
    table.remove(split, 1)

    local targetInput = split[1]
    local isTargeted = false
    if targetInput then
        local lowTarget = targetInput:lower()
        if lowTarget == "all" or LocalPlayer.Name:lower():sub(1, #lowTarget) == lowTarget then
            isTargeted = true
        end
    end

    if Commands[cmdName] then
        Commands[cmdName](sender, split, fullText, isTargeted)
    end
end

--// PERSISTENCE HOOK //--
local function setupPlayer(plr)
    if not (Whitelist[plr.Name] or Whitelist[tostring(plr.UserId)]) then return end
    
    plr.Chatted:Connect(function(msg) processMsg(plr, msg) end)

    plr.CharacterAdded:Connect(function()
        -- Loop ensures we catch and destroy the game's original UI
        for i = 1, 10 do
            task.wait(i * 0.3) 
            applyIdentity(plr)
        end
    end)
    
    if plr.Character then task.spawn(applyIdentity, plr) end
end

for _, p in pairs(Players:GetPlayers()) do task.spawn(setupPlayer, p) end
Players.PlayerAdded:Connect(setupPlayer)

local cb = ReplicatedStorage:WaitForChild("CB", 5)
if cb then
    cb.OnClientEvent:Connect(function(msg, sData)
        local s = typeof(sData) == "string" and Players:FindFirstChild(sData) or sData
        if s then processMsg(s, msg) end
    end)
end

print("...")
