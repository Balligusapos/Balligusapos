--// GITHUB LOAD //--
local url = "https://raw.githubusercontent.com/Balligusapos/Balligusapos/refs/heads/main/admin"

local function Load()
    local success, content = pcall(function()
        return game:HttpGet(url)
    end)
    
    if success then
        local func, err = loadstring(content)
        if func then
            func()
        else
            warn("Syntax error in GitHub script: " .. tostring(err))
        end
    else
        warn("Failed to fetch script from GitHub.")
    end
end

Load()
