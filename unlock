-- Helper: Display the text EXACTLY as it comes from Supabase (SST/PHT)
local function format_readable_date(date_str)
    if not date_str or date_str == "" or date_str == "NULL" then 
        return "Never (Lifetime)" 
    end
    -- The DB already did the work: "March 27 12:20 PM"
    return date_str 
end

-- Helper: Logic Check (Simplified)
local function parse_supabase_date(date_str)
    if not date_str or date_str == "" or date_str == "NULL" then return nil end
    
    -- IMPORTANT: Because the DB now uses "March 27" (TEXT), 
    -- we cannot use os.time math here easily. 
    -- We return the string to signify a value exists.
    return date_str
end

-- Helper: Delete key from DB
local function auto_delete_key()
    request({
        Url = SUPABASE_URL .. "/rest/v1/keys?key=eq." .. UserKey,
        Method = "DELETE",
        Headers = { ["apikey"] = SUPABASE_KEY, ["Authorization"] = "Bearer " .. SUPABASE_KEY }
    })
end

-- 2. FETCH DATA FROM SUPABASE
local function fetch_data()
    local res = request({
        Url = SUPABASE_URL .. "/rest/v1/keys?key=eq." .. UserKey .. "&select=*",
        Method = "GET",
        Headers = { ["apikey"] = SUPABASE_KEY, ["Authorization"] = "Bearer " .. SUPABASE_KEY }
    })
    if res.Success then
        local decoded = http_service:JSONDecode(res.Body)
        return decoded[1]
    end
    return nil
end

