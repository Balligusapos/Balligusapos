-- Helper: Parse Supabase ISO dates
local function parse_supabase_date(date_str)
    if not date_str or date_str == "" or date_str == "NULL" then return nil end
    local y, m, d, h, min, s = date_str:match("(%d+)-(%d+)-(%d+)T(%d+):(%d+):(%d+)")
    if y then
        return os.time({year=y, month=m, day=d, hour=h, min=min, sec=s})
    end
    return nil
end

