local MovementRemote = game.ReplicatedStorage.Remotes.PlayerMovementPackets:WaitForChild(Player.Name)

-- Configuration
Settings.MagnetRange = 100

local function CollectItem(item)
    if not Settings.Magnet or Settings.AntiCollect then return end
    if not item:IsA("BasePart") or item:GetAttribute("t") then return end

    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local distance = (root.Position - item.Position).Magnitude
    if distance <= Settings.MagnetRange then
        item:SetAttribute("t", true) -- Lock the item

        task.spawn(function()
            local oldCanCollide = item.CanCollide
            local oldAnchored = item.Anchored
            
            item.CanCollide = false
            item.Anchored = true
            
            local startPos = item.Position
            local duration = 0.25 
            local elapsed = 0
            
            while elapsed < duration do
                local step = game:GetService("RunService").Heartbeat:Wait()
                elapsed = elapsed + step
                
                -- Check if we should abort mid-flight
                if not Settings.Magnet or Settings.AntiCollect or not item.Parent or not root then
                    item.Anchored = oldAnchored
                    item.CanCollide = oldCanCollide
                    item:SetAttribute("t", nil) -- RESET: Allow re-collection
                    return 
                end
                
                local pc = math.min(elapsed / duration, 1)
                -- Dynamic Lerp: Always moving towards the CURRENT root position
                item.Position = startPos:Lerp(root.Position, pc)
            end

            -- Final Server Notification
            if item and item.Parent then
                MovementRemote:FireServer(Vector2.new(item.Position.X, item.Position.Y))
                
                -- [[ SAFETY NET ]]
                -- Wait a moment for server to destroy item. If it's still here, unlock it.
                task.wait(0.5)
                if item and item.Parent then
                    item.Anchored = oldAnchored
                    item.CanCollide = oldCanCollide
                    item:SetAttribute("t", nil) -- Release lock so magnet can try again
                end
            end
        end)
    end
end

