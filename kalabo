RunService.RenderStepped:Connect(function()
    -- Zoom Logic
    if Settings.MaxZoom then
        Player.CameraMaxZoomDistance = 100000
    else
        Player.CameraMaxZoomDistance = 128 
    end
    
    if Settings.Freecam then
        local moveVec = Vector3.new(0, 0, 0)
        
        -- 1. Determine Speed (Hold Shift on PC to go faster)
        local currentSpeed = Settings.FreecamSpeed

        -- 2. Vertical Movement (World Space)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) or MobileControls.Up then 
            moveVec = moveVec + Vector3.new(0, 1, 0) 
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) or MobileControls.Down then 
            moveVec = moveVec + Vector3.new(0, -1, 0) 
        end
        
        -- 3. Horizontal Movement (Camera Relative)
        local sideVec = Vector3.new(0, 0, 0)
        
        -- PC Keyboard (A/D)
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then sideVec = sideVec + Vector3.new(-1, 0, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then sideVec = sideVec + Vector3.new(1, 0, 0) end
        
        -- Mobile Buttons
        if MobileControls.Left then sideVec = sideVec + Vector3.new(1, 0, 0) end
        if MobileControls.Right then sideVec = sideVec + Vector3.new(-1, 0, 0) end
        
        -- 4. Apply Vector Math
        local finalMove = Vector3.new(0, moveVec.Y, 0) -- Vertical
        
        if sideVec.Magnitude > 0 then
            -- Multiply by RightVector so "Left/Right" is relative to your SCREEN
            finalMove = finalMove + (Camera.CFrame.RightVector * sideVec.X)
        end

        -- 5. Final Movement Update
        if finalMove.Magnitude > 0 then
            FreecamPart.Position = FreecamPart.Position + (finalMove.Unit * currentSpeed)
        end
        
        -- CRITICAL: Ensure Camera focuses on the FreecamPart
        Camera.CameraSubject = FreecamPart
        
    else
        -- Character Sync Logic
        local Character = Player.Character or workspace:FindFirstChild(Player.Name)
        if Character then
            local humanoid = Character:FindFirstChild("Humanoid")
            local rootPart = Character:FindFirstChild("HumanoidRootPart")
            
            Camera.CameraSubject = humanoid or Character
            
            -- Keep FreecamPart locked to Character when NOT in freecam
            if rootPart then
                FreecamPart.Position = rootPart.Position
            end
        end
    end
end)

