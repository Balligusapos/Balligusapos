            if v:IsA("ImageButton") or v:IsA("TextButton") then
                if v.Name == name then
                    if parentName then
                        if v.Parent and v.Parent.Name == parentName then
                            return v
                        end
                    else
                        return v
                    end
                end
            end
        end
        return nil
    end

    local jumpBtn = findBtn("JumpButton")
    local punchBtn = findBtn("PunchButton")
    local moveLeft = findBtn("Button", "Left")
    local moveRight = findBtn("Button", "Right")

    local function setup(btn, key)
