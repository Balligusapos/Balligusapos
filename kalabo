                -- Note: We set to Plastic as a safe default, 
                -- or you can use Enum.Material.Grass/Stone if the game is specific
                v.Material = Enum.Material.Plastic 
                v.CastShadow = true
            elseif v:IsA("Texture") or v:IsA("Decal") then
                v.Transparency = 0 -- Show textures again
            elseif v:IsA("ParticleEmitter") or v:IsA("Trail") then
                v.Enabled = true
            end
