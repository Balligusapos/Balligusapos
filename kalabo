        -- Handle Auto-Leave
        if Settings.AutoLeave then
            task.wait(0.5) -- Small delay so the warn sends first
            game:GetService("ReplicatedStorage").Remotes.RequestPlayerExitWorld:InvokeServer()
        end
    end
end

