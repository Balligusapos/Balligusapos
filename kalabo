createLog = function(pName, status, actionIcon, itemText, isLocal, customPlayerIcon)
    if ONLY_ME and not isLocal then return nil end
    local logEntry = Instance.new("Frame", LogContainer)
    logEntry.Size = UDim2.new(1, 0, 0, LOG_TEXT_SIZE + 8)
    logEntry.BackgroundTransparency = 1
    local createdAt = tick()
    logEntry:SetAttribute("IsLocal", isLocal)
    local searchTag = (pName .. status .. itemText):lower()
    logEntry:SetAttribute("SearchTag", searchTag)
    logEntry.Visible = searchTag:find(CURRENT_SEARCH) ~= nil
    local txtColor = isLocal and Color3.fromRGB(0, 255, 120) or Color3.new(1, 1, 1)
    local aIcon = Instance.new("ImageLabel", logEntry)
    aIcon.Size = UDim2.new(0, 14, 0, 14)
    aIcon.Position = UDim2.new(0, 2, 0.5, -7)
    aIcon.Image = actionIcon
    aIcon.BackgroundTransparency = 1
    local statusLbl = Instance.new("TextLabel", logEntry)
    statusLbl.Size = UDim2.new(0, 50, 1, 0)
    statusLbl.Position = UDim2.new(0, 20, 0, 0)
    statusLbl.BackgroundTransparency = 1
    statusLbl.Text = status:upper()
    statusLbl.TextColor3 = txtColor
    statusLbl.Font = Enum.Font.Code
    statusLbl.TextSize = LOG_TEXT_SIZE
    statusLbl.TextXAlignment = Enum.TextXAlignment.Left
    local pIcon = Instance.new("ImageLabel", logEntry)
    pIcon.Size = UDim2.new(0, 14, 0, 14)
    pIcon.Position = UDim2.new(0, 75, 0.5, -7)
    pIcon.Image = customPlayerIcon or ICON_PLAYER
    pIcon.BackgroundTransparency = 1
    local detailLbl = Instance.new("TextLabel", logEntry)
    detailLbl.Name = "DetailLabel"
    detailLbl.Size = UDim2.new(1, -145, 1, 0)
    detailLbl.Position = UDim2.new(0, 95, 0, 0)
    detailLbl.BackgroundTransparency = 1
    detailLbl.Text = string.format("%s | %s", pName:upper(), itemText:upper())
    detailLbl.TextColor3 = txtColor
    detailLbl.Font = Enum.Font.Code
    detailLbl.TextSize = LOG_TEXT_SIZE
    detailLbl.TextXAlignment = Enum.TextXAlignment.Left
    local timerLbl = Instance.new("TextLabel", logEntry)
    timerLbl.Name = "TimeLabel"
    timerLbl.Size = UDim2.new(0, 45, 1, 0)
    timerLbl.Position = UDim2.new(1, -48, 0, 0)
    timerLbl.BackgroundTransparency = 1
    timerLbl.Text = "now"
    timerLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
    timerLbl.Font = Enum.Font.Code
    timerLbl.TextSize = LOG_TEXT_SIZE - 1
    timerLbl.TextXAlignment = Enum.TextXAlignment.Right
    task.spawn(function()
        while logEntry and logEntry.Parent do
            local diff = math.floor(tick() - createdAt)
            timerLbl.Text = diff < 60 and diff .. "s ago" or math.floor(diff/60) .. "m ago"
            task.wait(1)
        end
    end)
    if pName ~= "SYSTEM" and pName ~= "WORLD" then
        task.spawn(function()
            while logEntry and logEntry.Parent do
                task.wait(1)
                if AUTO_CLEAR and (tick() - createdAt) >= LOG_LIFESPAN then
                    local t = TweenService:Create(detailLbl, TweenInfo.new(1), {TextTransparency = 1})
                    TweenService:Create(statusLbl, TweenInfo.new(1), {TextTransparency = 1}):Play()
                    TweenService:Create(pIcon, TweenInfo.new(1), {ImageTransparency = 1}):Play()
                    TweenService:Create(aIcon, TweenInfo.new(1), {ImageTransparency = 1}):Play()
                    TweenService:Create(timerLbl, TweenInfo.new(1), {TextTransparency = 1}):Play()
                    t:Play()
                    t.Completed:Connect(function() if logEntry.Parent then logEntry:Destroy() end end)
                    break
                end
            end
        end)
    end
    return logEntry
end

-- Detection
local function handleItem(item)
    if not item:IsA("BasePart") then return end
    local function info()
        local id = item:GetAttribute("id")
        return (id and ItemsManager.GetName(id)) or item.Name or "ITEM", item:GetAttribute("amount") or 1
    end
    task.spawn(function()
        task.wait(0.1) 
        local name, amt = info()
        local ownerName, isLocal, closestDist = "WORLD", false, 15
        for _, p in ipairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                local dist = (p.Character.HumanoidRootPart.Position - item.Position).Magnitude
                if dist < closestDist then closestDist, ownerName, isLocal = dist, p.DisplayName, (p == LocalPlayer) end
            end
        end
        createLog(ownerName, "DROPPED", ICON_DROP, name .. " x" .. amt, isLocal)
    end)
    item:GetAttributeChangedSignal("t"):Connect(function()
        local t = item:GetAttribute("t")
        if t then
            local p = Players:GetPlayerByUserId(tonumber(t))
            if p then
                local name, amt = info()
                createLog(p.DisplayName, "COLLECTED", ICON_PICKUP, name .. " x" .. amt, p == LocalPlayer)
            end
        end
    end)
end

