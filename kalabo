local function performCawScan()
    local inventory = {}
    local statusLog = createLog("SYSTEM", "WORLD", ICON_SEARCH, "SCANNING", true, ICON_SYSTEM)
    local label = statusLog:WaitForChild("DetailLabel", 2)
    
    local scanning = true
    task.spawn(function()
        local dots = 0
        while scanning and label and label.Parent do
            dots = (dots + 1) % 4
            label.Text = "SYSTEM | SCANNING" .. string.rep(".", dots)
            task.wait(0.3)
        end
    end)

    -- The actual indexing
    for _, item in ipairs(DropsFolder:GetChildren()) do
        if item:IsA("BasePart") then
            local id = item:GetAttribute("id")
            local name = (id and ItemsManager.GetName(id)) or item.Name or "ITEM"
            local amt = item:GetAttribute("amount") or 1
            inventory[name] = (inventory[name] or 0) + amt
        end
    end
    
    task.wait(0.4) 
    scanning = false
    if label then label.Text = "SYSTEM | SCAN COMPLETE" end

    -- Output totals
    for name, total in pairs(inventory) do
        createLog("WORLD", "TOTAL", ICON_AUTO, name .. " x" .. total, true, ICON_SYSTEM)
    end
end

