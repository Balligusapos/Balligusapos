            DroppedVal.Text = tostring(SessionDroppedCount)

            -- [[ SMART CALCULATION ]]
            -- We calculate what you SHOULD have left when the goal is reached.
            -- If not dropping: Current - Goal
            -- If dropping: We track how much of that goal is still remaining to be dropped.
            
            local remainingToDrop = math.max(0, goal - SessionDroppedCount)
            local finalResult = math.max(0, currentTotal - remainingToDrop)
            
            -- This prevents the "3000" error by ensuring we only subtract 
            -- the UNFINISHED part of your goal from your CURRENT total.
            RemainingVal.Text = tostring(finalResult)
            
            -- Reset session only if inventory INCREASES (Collecting)
            if currentTotal > (LastTotal or 0) then
                SessionDroppedCount = 0
            end
            
            LastTotal = currentTotal
        end
    end
end)

