local function StartDropProcess()
    if isDropping then 
        isDropping = false 
        ToggleBtn.Text = "START MULTI-DROP"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 220, 150)
        return 
    end

    local goal = tonumber(AmountInput.Text) or 0
    local startTotal = GetTotal()
    
    -- FIXED VARIABLE DEFINITION
    local waitDelay = 0.25 
    
    local expectedFinalTotal = math.max(0, startTotal - goal)
    
    if not LockedId or goal <= 0 or startTotal <= 0 then return end
    
    isDropping = true
    SessionDroppedCount = 0 
    
    ToggleBtn.Text = "STOP DROPPING"
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)

    task.spawn(function()
        while isDropping do
            local currentTotal = GetTotal()
            local actualLeftToDrop = currentTotal - expectedFinalTotal
            
            if actualLeftToDrop <= 0 then break end

            for slot, data in pairs(InventoryMod.Stacks) do
                if not isDropping then break end
                
                if data.Id == LockedId and not SlotLocks[slot] then
                    local slotAmt = tonumber(data.Amount) or 0
                    local batch = math.min(actualLeftToDrop, slotAmt, 250)

                    if batch > 0 then
                        SlotLocks[slot] = true
                        actualLeftToDrop = actualLeftToDrop - batch
                        
                        PlayerDropRemote:FireServer(slot, batch)
                        PromptEvent:FireServer({
                            ["ButtonAction"] = "drp", 
                            ["Inputs"] = {["amt"] = tostring(batch)}
                        })
                        
                        -- Dynamic Unlock based on the 0.25 variable
                        task.delay(waitDelay, function() 
                            SlotLocks[slot] = nil 
                        end)
                    end
                end
                if actualLeftToDrop <= 0 then break end
            end

            -- PHASE 2: WAIT
            task.wait(waitDelay) 
            
            if not isDropping then break end 
            
            local checkTotal = GetTotal()
            SessionDroppedCount = math.max(0, startTotal - checkTotal)
            
            if checkTotal <= expectedFinalTotal then break end
        end
        
        table.clear(SlotLocks) 
        isDropping = false
        ToggleBtn.Text = "START MULTI-DROP"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(0, 220, 150)
    end)
end

