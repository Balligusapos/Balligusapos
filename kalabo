local function ProcessCommand(msg)
    local args = string.split(msg, " ")
    if #args < 2 then return end
    
    local command = args[1]:lower()
    
    if command == "/di" then
        local amount = tonumber(args[2])
        
        -- Verification
        if not amount or not LockedId then 
            warn("DM [CSN]: Select an item first or enter a valid number.")
            return 
        end
        
        -- Update UI and Start
        AmountInput.Text = string.format("%.0f", amount)
        
        if not isDropping then
            task.defer(StartDropProcess)
        end
    end
end

